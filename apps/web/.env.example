# apps/web — lokale Env-Vorlage (Vite). Kopieren nach apps/web/.env.local.
# Keine Secrets/Modell-IDs hier — nur die Backend-Basis-URL (EU-lokal).

# Basis-URL des Souffleur-Backends. Default in src/config/env.ts ist
# http://localhost:8000 (siehe SOUFFLEUR_BACKEND_PORT in der Root .env.example).
VITE_SOUFFLEUR_API_BASE=http://localhost:8000
