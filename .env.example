# Souffleur AI — Beispiel-Umgebungsvariablen (KEINE echten Secrets committen)
# Kopieren nach .env und Platzhalter ersetzen. .env ist gitignored.

# --- Mistral (Single-Provider, EU-souverän, Paris) ---
MISTRAL_API_KEY=REPLACE_ME
MISTRAL_BASE_URL=https://api.mistral.ai

# --- STT-Port (austauschbar; reine Config) ---
# Erlaubte Werte: voxtral_api (Default) | voxtral_local | gladia
SOUFFLEUR_STT_PROVIDER=voxtral_api

# --- Gepinnte Modelle (Gate F1 — keine beweglichen Tags) ---
SOUFFLEUR_MODEL_STT_LIVE=voxtral-mini-transcribe-realtime-2602
SOUFFLEUR_MODEL_STT_BATCH=voxtral-mini-2602
SOUFFLEUR_MODEL_REASONING=magistral-medium-2509
SOUFFLEUR_MODEL_TRIGGER=ministral-3b-2512

# --- Gladia (NUR falls Live-Latenz-Fallback aktiv; EU-Endpunkt Frankreich) ---
GLADIA_API_KEY=REPLACE_ME
GLADIA_BASE_URL=https://api.gladia.io

# --- Lokaler Voxtral-Worker (MLX, Apple Silicon; nur bei voxtral_local) ---
SOUFFLEUR_VOXTRAL_LOCAL_URL=http://voxtral-worker:9000

# --- Coaching-MCP-Server ---
SOUFFLEUR_MCP_URL=http://coaching-mcp:8080

# --- Ports ---
SOUFFLEUR_BACKEND_PORT=8000
SOUFFLEUR_WEB_PORT=5173
SOUFFLEUR_MCP_PORT=8080

# --- Mandant / Audit / Aufbewahrung ---
SOUFFLEUR_TENANT_ID=zukunftsbund
SOUFFLEUR_AUDIT_LOG_PATH=./data/audit-log.jsonl
SOUFFLEUR_RETENTION_DAYS=30

# --- Consent (§201 StGB — explizite Einwilligung vor Aufnahme erzwingen) ---
SOUFFLEUR_REQUIRE_CONSENT=true
